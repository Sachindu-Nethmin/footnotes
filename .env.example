# Footnotes runs an open-weight model. Pick one of three ways.

# 1. LOCAL (default, most private): Ollama on this computer. Works with no internet for the writing.
#    ollama pull gemma4:e4b      (or gemma3:4b on smaller machines)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=gemma4:e4b

# 2. HOSTED: any OpenAI-compatible endpoint serving an open model (llama.cpp, vLLM, LM Studio,
#    or Gemma on Google AI Studio). Note: your diary chat would then go to that host.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemma-4-26b-a4b-it
# LLM_API_KEY=your-key

# 3. BROWSER ONLY: no server model. The notebook runs Gemma 2 2B inside the browser with WebLLM.
# LLM_PROVIDER=browser

# Open data, no keys needed:
# WIKIDATA_ENDPOINT=https://query.wikidata.org/sparql
# WEATHER_ENDPOINT=https://api.open-meteo.com/v1/forecast
# WIKI_USER_AGENT=Footnotes/0.1 (you@example.com)
